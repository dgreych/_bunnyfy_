# Copie para .env e preencha com valores reais. Nunca versione o .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# LOG_PRETTY=true
JSON_BODY_MAX_BYTES=1048576

# URL pública pela qual a API é alcançada — usada pra montar o shortUrl
# absoluto do link curto de imagem (mediaUrl em si é relativa).
PUBLIC_BASE_URL=http://localhost:8080

# Chaves Bearer identificáveis e com escopos. Não use este marcador no boot.
# Para provisionar o Gyomei sem imprimir a chave no terminal, execute:
#   npm run provision:gyomei-key -- --bot-dir /caminho/privado/do/gyomei
BUNNYFY_API_KEYS=[{"id":"exemplo","key":"SUBSTITUA_POR_CHAVE_GERADA","scopes":["media:read"]}]

# Compatibilidade temporária com tokens antigos, sem escopos. Novos consumidores
# devem usar somente BUNNYFY_API_KEYS.
# BUNNYFY_API_TOKENS=

# Segredo usado pra assinar URL de leitura de mídia. Gere do mesmo jeito acima.
MEDIA_SIGNING_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

# MEDIA_DIR=./data/tmp
MEDIA_MAX_BYTES=104857600
MEDIA_TTL_SECONDS=600
MEDIA_SWEEP_INTERVAL_MS=60000

DOWNLOAD_TIMEOUT_MS=15000
DOWNLOAD_MAX_BYTES=209715200

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Deno continua sendo o padrão recomendado. YOUTUBE_JS_RUNTIME permite um
# runtime compatível explícito em hosts restritos, sem fingir que Bun/Node são Deno.
DENO_PATH=deno
YOUTUBE_JS_RUNTIME=deno
# YOUTUBE_JS_RUNTIME_PATH=
YOUTUBE_DOWNLOAD_TIMEOUT_MS=120000
YOUTUBE_DOWNLOAD_MAX_CONCURRENCY=2
# Egress próprio opcional. URL e segredo ficam privados e só são exigidos ao ativar.
YOUTUBE_EGRESS_ENABLED=false
YOUTUBE_EGRESS_URL=
YOUTUBE_EGRESS_SHARED_SECRET=
# Fallback temporário e privado. Nunca registre a URL completa da requisição,
# pois a credencial é enviada ao upstream conforme o contrato legado dele.
YOUTUBE_FALLBACK_ENABLED=false
YOUTUBE_FALLBACK_BASE_URL=
YOUTUBE_FALLBACK_API_KEY=
# Vazio usa apenas o host da URL base; liste hosts adicionais separados por vírgula.
YOUTUBE_FALLBACK_MEDIA_HOSTS=
YOUTUBE_FALLBACK_MAX_CONTROL_BYTES=262144

# Caminho do binário whisper-cli (whisper.cpp) e do arquivo de modelo .bin —
# nenhum dos dois entra no Git. O modelo padrão é multilíngue para suportar PT-BR.
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODEL_PATH=./models/ggml-base.bin
TRANSCRIPTION_TIMEOUT_MS=120000
TRANSCRIPTION_MAX_CONCURRENCY=2
TRANSCRIPTION_MAX_INPUT_BYTES=52428800

# Remoção de fundo. Instale a versão fixada em requirements-rembg.txt e
# provisione o modelo fora do Git antes do deploy.
REMBG_PATH=rembg
REMBG_MODEL=silueta
REMBG_MODEL_DIR=./models/rembg
REMBG_OMP_NUM_THREADS=2
BACKGROUND_REMOVAL_TIMEOUT_MS=120000

# Processamento de imagens. O mesmo semáforo protege remoção de fundo e upscale.
IMAGE_UPSCALE_TIMEOUT_MS=30000
IMAGE_PROCESS_MAX_CONCURRENCY=1
IMAGE_MAX_INPUT_PIXELS=16000000
IMAGE_MAX_OUTPUT_PIXELS=36000000
IMAGE_MAX_OUTPUT_DIMENSION=16384
IMAGE_MAX_OUTPUT_BYTES=20971520

# Social Canvas: concorrência e tetos independentes dos uploads genéricos.
CANVAS_MAX_CONCURRENCY=2
CANVAS_MAX_AVATAR_BYTES=5242880
CANVAS_MAX_TOTAL_AVATAR_BYTES=20971520
CANVAS_MAX_OUTPUT_BYTES=10485760
LOGO_RENDER_TIMEOUT_MS=45000
LOGO_MAX_CONCURRENCY=1
LOGO_MAX_OUTPUT_BYTES=8388608

# Quiz de cinema. A resposta pública contém atribuição da fonte licenciada.
MOVIE_QUIZ_ENABLED=false
MOVIE_QUIZ_TIMEOUT_MS=10000
MOVIE_QUIZ_MAX_RESPONSE_BYTES=262144
MOVIE_QUIZ_RATE_WINDOW_MS=5000

# Gateway de conversa. Credencial e modelo pertencem somente à BunnyFy; nunca
# replique estes valores no bot. Mantenha desativado até configurar uma
# credencial autorizada para o ambiente e o uso pretendidos.
# Leia a credencial por stdin para evitar argumento e histórico de shell:
#   printf '%s' "$SEGREDO_PRIVADO" | npm run configure:ai -- --model fornecedor/modelo --allow-model fornecedor/modelo --enable
AI_CHAT_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Lista fechada de modelos que consumidores autorizados podem selecionar.
# O modelo padrão acima precisa estar incluído.
NVIDIA_ALLOWED_MODELS=
AI_CHAT_TIMEOUT_MS=120000
AI_CHAT_MAX_CONCURRENCY=2
AI_CHAT_MAX_CONCURRENCY_PER_CONSUMER=1
AI_CHAT_MAX_REQUESTS_PER_MINUTE=30
AI_CHAT_MAX_REQUESTS_PER_MINUTE_PER_CONSUMER=10
AI_CHAT_MAX_MESSAGES=24
AI_CHAT_MAX_MESSAGE_CHARS=16000
AI_CHAT_MAX_TOTAL_CHARS=48000
AI_CHAT_MAX_OUTPUT_TOKENS=2000
AI_CHAT_MAX_RESPONSE_BYTES=1048576

SHUTDOWN_TIMEOUT_MS=10000
