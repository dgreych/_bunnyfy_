{
  "name": "bunnyfy",
  "version": "0.1.0",
  "description": "API própria da BunnyFy — fundação e primeiro corte vertical (YouTube).",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-runtime.mjs",
    "dev": "tsx watch src/index.ts",
    "prestart": "node scripts/check-runtime.mjs",
    "start": "tsx src/index.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "verify:portability": "node scripts/verify-portability.mjs",
    "preflight": "tsx scripts/preflight.ts",
    "smoke:whisper": "tsx scripts/smoke-whisper.ts",
    "smoke:background-removal": "tsx scripts/smoke-background-removal.ts",
    "smoke:upscale": "tsx scripts/smoke-upscale.ts",
    "smoke:ai": "tsx scripts/smoke-ai-gateway.ts",
    "provision:gyomei-key": "tsx scripts/provision-gyomei-key.ts",
    "configure:ai": "tsx scripts/configure-ai.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "preverify": "node scripts/check-runtime.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.2.1",
    "ipaddr.js": "^2.2.0",
    "jimp": "^0.16.13",
    "pino": "^9.6.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
